# Copy to .env.local and fill in. Never commit .env.local.
# Everything here is NEXT_PUBLIC_*, so it ships to the browser.
# Secrets do NOT belong in this repo. The Supabase secret key lives only in timbang-api.

# --- Supabase (Auth) ---
# Local: printed by `supabase start` in timbang-api
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser because RLS guards every user table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- timbang-api ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API mocking (MSW) ---
# enabled = fake responses, no backend needed. disabled = call the real API.
NEXT_PUBLIC_API_MOCKING=enabled
